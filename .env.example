# ─────────────────────────────────────────────────────────────────
#  AI Assembly — Environment Configuration TEMPLATE
#  Copy this file to ".env" and paste your keys.
#
#  LLM design: AUTOMATIC FALLBACK CHAIN.
#  Fill in as many keys as you like. The app tries them in this
#  order: Groq → OpenRouter → Cerebras → Mistral → Together → Custom.
#  If one fails (rate limit, outage, bad key), the next one is used.
#  Providers without a key are silently skipped.
# ─────────────────────────────────────────────────────────────────

# ── AI PROVIDER MODE ──────────────────────────────────────────────
# "openai"  → use the cloud fallback chain below (recommended)
# "ollama"  → local-only, no fallback (needs Ollama running)
AI_PROVIDER=openai

# ── OLLAMA (local, optional) ──────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────────────────────────────
#  CLOUD LLM FALLBACK CHAIN  (need at least ONE)
# ─────────────────────────────────────────────────────────────────

# 1️⃣  GROQ — fastest, generous free tier  (PRIMARY)
#     Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 2️⃣  OPENROUTER — many free models, used if Groq fails
#     Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 3️⃣  CEREBRAS — very fast, free tier
#     Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# 4️⃣  MISTRAL — paid (skip unless you have a paid account)
#     Get key: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 5️⃣  TOGETHER AI — free $5 credit on signup
#     Get key: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf

# 6️⃣  CUSTOM (advanced) — any other OpenAI-compatible endpoint
#     e.g. DeepSeek, Anyscale, your own server. Leave blank to skip.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────

# ── YOUTUBE DATA API (free, optional but recommended) ─────────────
# Powers real videos in the lesson "Watch & Learn" stage.
#   1. https://console.cloud.google.com/apis/credentials
#   2. Enable "YouTube Data API v3"
#   3. Credentials → Create credentials → API key → copy
# Free quota: 10,000 units/day (~100 searches).
YOUTUBE_API_KEY=
